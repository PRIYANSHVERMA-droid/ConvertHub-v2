{
  "name": "converthub-v2",
  "version": "2.1.0",
  "description": "ConvertHub v2 - Universal File Converter",
  "main": "main.js",
  "author": "Priyansh Verma",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.converthub.v2",
    "productName": "ConvertHub v2",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "engines",
        "to": "engines"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PRIYANSHVERMA-droid",
        "repo": "ConvertHub-v2"
      }
    ]
  },
  "dependencies": {
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "electron-updater": "^6.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  }
}
